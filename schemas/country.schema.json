{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PhD Country Profile Schema",
  "type": "object",
  "required": [
    "id",
    "name",
    "capital",
    "stipend",
    "tuition_fees",
    "cost_of_living",
    "phd_system",
    "visa_and_work_rights",
    "funding_availability",
    "happiness_index",
    "climate",
    "contact_portals",
    "sources"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z_-]+$"
    },
    "name": {
      "type": "string"
    },
    "capital": {
      "type": "string"
    },
    "stipend": {
      "type": "object",
      "required": [
        "amount_eur_per_year",
        "is_taxable",
        "is_social_security_covered",
        "deductions_percent"
      ],
      "additionalProperties": false,
      "properties": {
        "amount_eur_per_year": {
          "type": [
            "number",
            "null"
          ]
        },
        "is_taxable": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "is_social_security_covered": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "deductions_percent": {
          "description": "Income tax + employee social contributions as % of gross (0 for untaxed stipends without deductions). Refreshed from OECD Taxing Wages for taxed salaries.",
          "type": "number",
          "minimum": 0,
          "maximum": 60
        },
        "local": {
          "description": "The pay figure as published at the source, in its own currency. `npm run data:refresh` converts it to amount_eur_per_year.",
          "type": "object",
          "required": [
            "amount",
            "currency",
            "per",
            "description"
          ],
          "additionalProperties": false,
          "properties": {
            "amount": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "currency": {
              "type": "string",
              "pattern": "^[A-Z]{3}$"
            },
            "per": {
              "type": "string",
              "enum": [
                "month",
                "year"
              ]
            },
            "payments_per_year": {
              "type": "number",
              "minimum": 1,
              "maximum": 15
            },
            "description": {
              "type": "string"
            }
          }
        }
      }
    },
    "tuition_fees": {
      "type": "object",
      "required": [
        "eu_students_eur_per_year",
        "non_eu_students_eur_per_year"
      ],
      "additionalProperties": false,
      "properties": {
        "eu_students_eur_per_year": {
          "type": [
            "number",
            "null"
          ]
        },
        "non_eu_students_eur_per_year": {
          "type": [
            "number",
            "null"
          ]
        }
      }
    },
    "cost_of_living": {
      "type": "object",
      "required": [
        "estimated_monthly_expenses_eur",
        "low_eur_per_month",
        "high_eur_per_month",
        "index_relative_to_eu_average",
        "local"
      ],
      "additionalProperties": false,
      "properties": {
        "estimated_monthly_expenses_eur": {
          "description": "Midpoint of the low/high range in EUR (computed by npm run data:refresh).",
          "type": "number",
          "exclusiveMinimum": 0
        },
        "index_relative_to_eu_average": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "low_eur_per_month": {
          "description": "Cheaper university city, EUR/month (computed from local).",
          "type": "number",
          "exclusiveMinimum": 0
        },
        "high_eur_per_month": {
          "description": "Most expensive university city, EUR/month (computed from local).",
          "type": "number",
          "exclusiveMinimum": 0
        },
        "local": {
          "description": "Monthly living-cost range for one person as published at the source (student-style budget), in its own currency.",
          "type": "object",
          "required": [
            "low",
            "high",
            "currency",
            "description"
          ],
          "additionalProperties": false,
          "properties": {
            "low": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "high": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "currency": {
              "type": "string",
              "pattern": "^[A-Z]{3}$"
            },
            "description": {
              "type": "string"
            }
          }
        }
      }
    },
    "phd_system": {
      "type": "object",
      "required": [
        "typical_duration_years",
        "is_employee_status"
      ],
      "additionalProperties": false,
      "properties": {
        "typical_duration_years": {
          "type": [
            "number",
            "null"
          ]
        },
        "is_employee_status": {
          "type": [
            "boolean",
            "null"
          ]
        }
      }
    },
    "visa_and_work_rights": {
      "type": "object",
      "required": [
        "post_study_work_visa_duration_months"
      ],
      "additionalProperties": false,
      "properties": {
        "post_study_work_visa_duration_months": {
          "type": [
            "number",
            "null"
          ]
        },
        "eu_free_movement": {
          "description": "false where EU citizens have no free movement (the UK since Brexit). Defaults to true.",
          "type": "boolean"
        }
      }
    },
    "funding_availability": {
      "type": "object",
      "required": [
        "main_sources"
      ],
      "additionalProperties": false,
      "properties": {
        "main_sources": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "happiness_index": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 10
    },
    "climate": {
      "type": "object",
      "required": [
        "average_temperature_summer_c",
        "average_temperature_winter_c"
      ],
      "additionalProperties": false,
      "properties": {
        "average_temperature_summer_c": {
          "type": [
            "number",
            "null"
          ]
        },
        "average_temperature_winter_c": {
          "type": [
            "number",
            "null"
          ]
        }
      }
    },
    "contact_portals": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "title",
          "url"
        ],
        "additionalProperties": false,
        "properties": {
          "title": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          }
        }
      }
    },
    "description": {
      "type": "object",
      "required": [
        "overview"
      ],
      "additionalProperties": false,
      "properties": {
        "overview": {
          "type": "string"
        },
        "pros": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "cons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "sources": {
      "description": "Where each manually researched figure comes from. topic says which part of the profile the source backs.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "topic",
          "title",
          "url",
          "accessed"
        ],
        "additionalProperties": false,
        "properties": {
          "topic": {
            "type": "string",
            "enum": [
              "pay",
              "deductions",
              "visa",
              "tuition",
              "phd_system",
              "living_costs",
              "funding"
            ]
          },
          "title": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "accessed": {
            "type": "string",
            "format": "date"
          },
          "note": {
            "type": "string"
          }
        }
      }
    }
  }
}
