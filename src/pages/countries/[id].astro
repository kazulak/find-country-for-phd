---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { countries, meta } from '../../data/countries';

export async function getStaticPaths() {
  return countries.map((country) => ({
    params: { id: country.id },
    props: { country },
  }));
}

const { country } = Astro.props;
const base = import.meta.env.BASE_URL;

const savingsMargin = country.netIncome - country.costOfLiving;
const isPositive = savingsMargin > 0;
const euro = (n: number) => `€${n.toLocaleString('en-GB')}`;
const fee = (n: number) => (n === 0 ? 'None (€0/yr)' : `${euro(n)}/year`);

const description = `Rough numbers for doing a PhD in ${country.name}: about ${euro(country.netIncome)}/month net pay, ${euro(country.costOfLiving)}/month living costs, and a ${country.postStudyVisaMonths}-month post-PhD stay for non-EU graduates.`;

const auto = meta.automated_sources;
const TOPIC_LABELS: Record<string, string> = {
  pay: 'Pay', deductions: 'Tax & contributions', visa: 'Visa', tuition: 'Tuition',
  phd_system: 'PhD system', living_costs: 'Living costs', funding: 'Funding',
};
const deductionsText = country.deductionsPercent === 0
  ? 'no deductions'
  : country.isTaxable
    ? `about ${country.deductionsPercent}% income tax and employee contributions`
    : `about ${country.deductionsPercent}% social contributions (no income tax)`;
const payBasis = country.payBasis?.replace(/\.$/, '');
---

<Layout title={`PhD in ${country.name}: pay, living costs & visas | PhD Europe`} description={description}>
  <Header />

  <main class="container country-page">
    <!-- Back Navigation -->
    <div class="nav-breadcrumbs">
      <a href={base} class="back-link">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 6px;" aria-hidden="true"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
        Back to all countries
      </a>
    </div>

    <!-- Country Main Header -->
    <header class="country-header">
      <div class="header-main-row">
        <span class="country-flag-large" aria-hidden="true">{country.flag}</span>
        <div class="header-text">
          <h1 class="country-title">PhD in {country.name}</h1>
          <div class="meta-badges">
            <span class="status-badge-large">{country.status} Model</span>
            <span class="region-badge">{country.region}</span>
          </div>
        </div>
      </div>
    </header>

    <!-- Content Sections Grid -->
    <div class="country-details-grid">

      <!-- Column 1: Key Facts and Financials -->
      <section class="details-main-column">

        <!-- Summary Section -->
        <div class="content-card">
          <h2>System Overview</h2>
          <p class="overview-text">{country.overview}</p>
          <div class="meta-info-row">
            <span><strong>Capital:</strong> {country.capital}</span>
            <span><strong>Academic Calendar:</strong> {country.academicCalendar}</span>
          </div>
        </div>

        <!-- Key Financial & Academic Facts -->
        <div class="content-card">
          <h2>Key Figures (Rough Estimates)</h2>
          <div class="facts-table-grid">
            <div class="fact-row">
              <span class="fact-lbl">Gross Pay / Stipend</span>
              <span class="fact-val">{euro(country.grossSalary)} / month{country.isTaxable ? '' : ' (untaxed)'}</span>
            </div>
            {payBasis && <p class="fact-note">{payBasis}.</p>}
            <div class="fact-row">
              <span class="fact-lbl">Estimated Net Pay</span>
              <span class="fact-val">{euro(country.netIncome)} / month</span>
            </div>
            <p class="fact-note">Gross minus {deductionsText}.</p>
            <div class="fact-row">
              <span class="fact-lbl">Estimated Living Cost</span>
              <span class="fact-val">~{euro(country.costOfLiving)} / month</span>
            </div>
            <p class="fact-note">Author's estimate for one person on a modest budget (not yet sourced).</p>
            <div class="fact-row">
              <span class="fact-lbl">Left Over Each Month</span>
              <span class={`fact-val ${isPositive ? 'savings-positive' : 'savings-negative'}`}>
                {isPositive ? `+${euro(savingsMargin)}` : `-${euro(Math.abs(savingsMargin))}`} / month
              </span>
            </div>
            <div class="fact-row">
              <span class="fact-lbl">Price Level (EU avg. = 100)</span>
              <span class="fact-val">{country.priceIndex} ({country.priceLevel})</span>
            </div>
            <div class="fact-row">
              <span class="fact-lbl">Typical Programme Duration</span>
              <span class="fact-val">{country.duration}</span>
            </div>
            <div class="fact-row">
              <span class="fact-lbl">Programme Structure</span>
              <span class="fact-val">{country.structure}{country.requiredEcts > 0 ? ` (${country.requiredEcts} ECTS)` : ''}</span>
            </div>
            <div class="fact-row">
              <span class="fact-lbl">Life Satisfaction (0–10)</span>
              <span class="fact-val">{country.happinessIndex ?? 'No data yet'}</span>
            </div>
            <div class="fact-row">
              <span class="fact-lbl">Climate</span>
              <span class="fact-val">{country.climate.type} · avg. {country.climate.summerC}°C summer / {country.climate.winterC}°C winter</span>
            </div>
          </div>
        </div>

        <!-- Applicant Conditions -->
        <div class="content-card">
          <h2>EU vs. Non-EU Applicants</h2>
          <div class="applicant-split">
            <div class="eligibility-box">
              <h3>EU / EEA Citizens</h3>
              <ul>
                <li><strong>Tuition Fees:</strong> {fee(country.tuitionFeesEU)}</li>
                <li><strong>Visa:</strong> Not needed (free movement)</li>
                <li><strong>Work Rights:</strong> Same as locals, during and after the PhD</li>
              </ul>
            </div>
            <div class="eligibility-box">
              <h3>Non-EU / International Citizens</h3>
              <ul>
                <li><strong>Tuition Fees:</strong> {fee(country.tuitionFeesNonEU)}</li>
                <li><strong>Visa:</strong> {country.requiresVisaNonEU ? 'Student or researcher permit required' : 'Not required'}</li>
                <li><strong>After the PhD:</strong> {country.postStudyVisaMonths > 0 ? `Up to ${country.postStudyVisaMonths} months to stay and look for work` : 'No dedicated post-study permit'}</li>
              </ul>
            </div>
          </div>
        </div>

        <!-- How PhDs are funded -->
        <div class="content-card">
          <h2>Funding & Where to Look</h2>
          {country.fundingSources.length > 0 && (
            <p class="section-paragraph">
              <strong>Main funders:</strong> {country.fundingSources.join(' · ')}
            </p>
          )}
          <p class="section-paragraph">
            Official portals and references for {country.name}. Start here, then confirm the exact terms with the university or funder:
          </p>
          <div class="sources-list">
            {country.portals.map((portal) => (
              <a href={portal.url} target="_blank" rel="noopener noreferrer" class="portal-link-item">
                <span class="portal-title">{portal.title}</span>
                <span class="portal-url">{portal.url} <span aria-hidden="true">↗</span><span class="sr-only">(opens in a new tab)</span></span>
              </a>
            ))}
          </div>
        </div>

      </section>

      <!-- Column 2: Pros, Cons, and Cautions -->
      <section class="details-sidebar-column">

        <!-- Warnings Banner -->
        {country.warnings.length > 0 && (
          <div class="warning-alert-card">
            <h2>⚠️ Worth Knowing</h2>
            <ul>
              {country.warnings.map((warning) => (
                <li>{warning}</li>
              ))}
            </ul>
          </div>
        )}

        <!-- Advantages & Cautions -->
        <div class="content-card">
          <h2>Upsides</h2>
          <ul class="pros-bullet-list">
            {country.pros.map((pro) => (
              <li>
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" class="bullet-check" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
                <span>{pro}</span>
              </li>
            ))}
          </ul>
        </div>

        <div class="content-card">
          <h2>Downsides</h2>
          <ul class="cons-bullet-list">
            {country.cons.map((con) => (
              <li>
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" class="bullet-cross" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                <span>{con}</span>
              </li>
            ))}
          </ul>
        </div>

        <!-- Per-country sources -->
        <div class="content-card sources-card">
          <h2>Sources for {country.name}</h2>
          <ul class="source-list">
            {country.sources.map((source) => (
              <li>
                <span class="source-topic">{TOPIC_LABELS[source.topic]}</span>
                <a href={source.url} target="_blank" rel="noopener noreferrer">{source.title}<span class="sr-only"> (opens in a new tab)</span></a>
                <span class="source-meta">Accessed {source.accessed}{source.note ? `. ${source.note}` : ''}</span>
              </li>
            ))}
          </ul>
        </div>

        <!-- Method -->
        <div class="content-card sources-card">
          <h2>How These Numbers Work</h2>
          <p><strong>Pay:</strong> first-year gross pay from the official pay table or funder rules cited above, including guaranteed extras such as holiday pay or a 13th/14th month. Converted to euros at the {auto.exchange_rates?.year ?? 'latest'} ECB average rate.</p>
          <p><strong>Net pay:</strong> taxed salaries use the OECD <em>Taxing Wages</em> rate ({auto.pay_deductions?.year ?? 'latest year'}) for a single person at 67% of the average wage. Untaxed stipends subtract only the contributions documented above. Your real payslip will differ.</p>
          <p><strong>Price level:</strong> Eurostat ({auto.price_level_index?.year ?? 'latest year'}). <strong>Life satisfaction:</strong> World Happiness Report ({auto.life_satisfaction?.year ?? 'latest year'}). <strong>Climate:</strong> ERA5 reanalysis for the capital, {auto.climate?.period ?? 'last 10 years'}.</p>
          <p><strong>Spotted a mistake?</strong> <a href="https://github.com/kazulak/find-country-for-phd/issues" target="_blank" rel="noopener noreferrer">Open an issue on GitHub</a>. Corrections with a source link are very welcome.</p>
        </div>

      </section>

    </div>
  </main>

  <Footer />
</Layout>

<style>
  .country-page {
    padding-top: 20px;
    padding-bottom: 60px;
    max-width: 1100px;
    margin: 0 auto;
  }

  .nav-breadcrumbs {
    margin-bottom: 24px;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--text-secondary);
    border: 1px solid var(--border-color);
    padding: 8px 16px;
    border-radius: var(--radius-sm);
    background: var(--bg-secondary);
  }

  .back-link:hover {
    color: var(--primary-hover);
    border-color: var(--primary);
    background: var(--bg-tertiary);
  }

  .country-header {
    margin-bottom: 30px;
    border-bottom: 1px solid var(--border-color);
    padding-bottom: 24px;
  }

  .header-main-row {
    display: flex;
    gap: 24px;
    align-items: center;
  }

  .country-flag-large {
    font-size: 4rem;
    line-height: 1;
  }

  .country-title {
    font-size: 2.5rem;
    font-weight: 800;
    color: var(--text-primary);
  }

  .meta-badges {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    margin-top: 8px;
  }

  .status-badge-large, .region-badge {
    font-size: 0.8rem;
    font-weight: 600;
    padding: 6px 12px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border-color);
  }

  .status-badge-large {
    background: var(--primary-glow);
    color: var(--primary-hover);
    border-color: rgba(139, 92, 246, 0.2);
  }

  .region-badge {
    background: var(--bg-tertiary);
    color: var(--text-secondary);
  }


  .country-details-grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: 30px;
  }

  .details-main-column, .details-sidebar-column {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .content-card {
    background: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    padding: 24px;
  }

  .content-card h2 {
    font-size: 1.4rem;
    font-weight: 700;
    margin-bottom: 16px;
    color: var(--text-primary);
    border-bottom: 1px solid var(--border-color);
    padding-bottom: 8px;
  }

  .overview-text {
    font-size: 1.05rem;
    line-height: 1.6;
    margin-bottom: 16px;
  }

  .meta-info-row {
    display: flex;
    gap: 24px;
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  .section-paragraph {
    margin-bottom: 16px;
  }

  /* Facts Table Grid */
  .facts-table-grid {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .fact-row {
    display: flex;
    justify-content: space-between;
    padding: 10px 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.04);
  }

  .fact-note {
    font-size: 0.8rem;
    color: var(--text-muted);
    margin: -4px 0 6px;
    line-height: 1.45;
  }

  .source-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 12px;
    font-size: 0.85rem;
  }

  .source-list li {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .source-topic {
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-secondary);
  }

  .source-meta {
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  .fact-row:last-child {
    border-bottom: none;
  }

  .fact-lbl {
    color: var(--text-secondary);
    font-weight: 500;
  }

  .fact-val {
    font-weight: 700;
    color: var(--text-primary);
  }

  .savings-positive {
    color: var(--success);
  }

  .savings-negative {
    color: var(--danger);
  }

  /* Applicant Eligibility Split */
  .applicant-split {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
  }

  .eligibility-box {
    background: var(--bg-tertiary);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-sm);
    padding: 16px;
  }

  .eligibility-box h3 {
    font-size: 1.1rem;
    margin-bottom: 12px;
    color: var(--text-primary);
  }

  .eligibility-box ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .eligibility-box li {
    font-size: 0.9rem;
    color: var(--text-secondary);
  }

  /* Warning Alert Card */
  .warning-alert-card {
    background: rgba(244, 63, 94, 0.05);
    border: 1px solid rgba(244, 63, 94, 0.2);
    border-radius: var(--radius-md);
    padding: 24px;
    color: var(--text-primary);
  }

  .warning-alert-card h2 {
    font-size: 1.25rem;
    font-weight: 700;
    margin-bottom: 12px;
    color: var(--accent);
  }

  .warning-alert-card ul {
    padding-left: 20px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .warning-alert-card li {
    font-size: 0.95rem;
    color: var(--text-secondary);
  }

  /* Pros / Cons lists */
  .pros-bullet-list, .cons-bullet-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .pros-bullet-list li, .cons-bullet-list li {
    display: flex;
    align-items: flex-start;
    gap: 10px;
  }

  .bullet-check {
    color: var(--success);
    margin-top: 3px;
    flex-shrink: 0;
  }

  .bullet-cross {
    color: var(--accent);
    margin-top: 3px;
    flex-shrink: 0;
  }

  /* Portals / Sources Links */
  .sources-list {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .portal-link-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border: 1px solid var(--border-color);
    background: var(--bg-tertiary);
    padding: 12px 16px;
    border-radius: var(--radius-sm);
    font-size: 0.95rem;
  }

  .portal-link-item:hover {
    border-color: var(--primary);
    background: var(--bg-secondary);
  }

  .portal-title {
    font-weight: 600;
    color: var(--text-primary);
  }

  .portal-url {
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  .sources-card p {
    font-size: 0.85rem;
    margin-bottom: 8px;
    line-height: 1.5;
  }

  .sources-card a {
    color: var(--primary-hover);
    text-decoration: underline;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .sources-card p:last-child {
    margin-bottom: 0;
  }

  @media (max-width: 820px) {
    .country-details-grid {
      grid-template-columns: 1fr;
    }
    .applicant-split {
      grid-template-columns: 1fr;
    }
  }
</style>
