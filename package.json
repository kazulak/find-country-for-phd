{
  "name": "find-country-for-phd",
  "version": "1.0.0",
  "private": true,
  "description": "Compare PhD pay, living costs, tuition and visa rules across 30 European countries. A static Astro site on a sourced YAML dataset, built with AI assistance (Claude Code).",
  "license": "MIT",
  "author": "Tomasz Kazulak",
  "homepage": "https://kazulak.github.io/find-country-for-phd/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kazulak/find-country-for-phd.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "npm run data:build && astro dev",
    "build": "npm run validate && npm run test && npm run data:build && astro build && npm run verify",
    "preview": "astro preview",
    "validate": "node scripts/validate.js",
    "data:build": "node scripts/build.js",
    "report": "node scripts/report.js",
    "test": "node --test \"tests/unit/*.test.js\"",
    "test:e2e": "playwright test",
    "verify": "node scripts/verify-output.js",
    "data:refresh": "node scripts/refresh-data.js",
    "data:check-links": "node scripts/check-links.js"
  },
  "dependencies": {
    "@astrojs/react": "^7.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "ajv": "^8.12.0",
    "ajv-formats": "^3.0.1",
    "astro": "^7.0.7",
    "js-yaml": "^5.4.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0"
  }
}
